# Neon — Dashboard Neon > Connection string (usa la "pooled connection")
DATABASE_URL="postgresql://utente:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob — creato in automatico collegando uno Store Blob al progetto
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Chiave per firmare i cookie di sessione. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiami-con-32-byte-casuali"

# Credenziali iniziali dell'admin, usate solo da `npm run db:setup`
ADMIN_USERNAME="simone"
ADMIN_PASSWORD="scegli-una-password-lunga"
