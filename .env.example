# Neon — Dashboard Neon > Connection string (usa la "pooled connection").
# Su Vercel la imposta da sola l'integrazione Neon.
DATABASE_URL="postgresql://utente:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob — creata da sola collegando uno Store Blob al progetto.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Chiave per firmare i cookie di sessione (almeno 32 caratteri). Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiami-con-32-byte-casuali"

# --- Solo per l'installazione iniziale. Vanno RIMOSSE quando è finita. ---

# Finché questa è impostata, /api/setup funziona. Tolta, risponde 404.
# Almeno 16 caratteri.
SETUP_TOKEN=""

# Utente del pannello. La password deve essere di almeno 12 caratteri.
ADMIN_USERNAME="simone"
ADMIN_PASSWORD=""

# Serve solo ai test: in produzione va lasciata vuota.
# NEON_FETCH_ENDPOINT=""
